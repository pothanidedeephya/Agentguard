# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL / Supabase connection URI for AgentGuard persistent security events.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_SUPABASE_PROJECT.supabase.co:5432/postgres?sslmode=require"

# Server Port (Default: 3000)
PORT="3000"

# Application Environment (development | production)
NODE_ENV="development"

# AGENTGUARD_API_TOKEN: Server-side API token to protect privileged gateway endpoints.
# If configured, clients must provide Bearer <token> or x-agentguard-token header.
AGENTGUARD_API_TOKEN=""

# VITE_API_BASE_URL: Client-side URL to the AgentGuard backend daemon (leave empty for same origin).
VITE_API_BASE_URL=""
